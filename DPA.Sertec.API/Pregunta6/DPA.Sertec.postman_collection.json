                  "pm.test('Cada tipo trae Id, Nombre y PrecioBase', function () {",
                  "    const primero = pm.response.json()[0];",
                  "    pm.expect(primero).to.have.property('id');",
                  "    pm.expect(primero).to.have.property('nombre');",
